{
  "name": "many-hands-book",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Many Hands: the handbook, run — the interactive book for Many Hands Engineering",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 5199 --strictPort",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "shoot": "node scripts/screenshot.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@vitejs/plugin-react": "^4.5.0",
    "@vitest/coverage-v8": "^3.1.4",
    "eslint": "^9.27.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.52.0",
    "prettier": "^3.5.0",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  }
}
